{
  "name": "erebus-world-editor",
  "version": "26.1.1",
  "private": true,
  "description": "Erebus World Editor 2026: the RoboCupJunior Rescue Simulation (Erebus) 2026 world editor, as a static site (Vue 3, TypeScript, Vite)",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/vendor.mjs && vite",
    "build": "node scripts/vendor.mjs && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@techstark/opencv-js": "5.0.0-release.1",
    "vue": "3.5.44",
    "vue-i18n": "11.4.14"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  },
  "type": "module"
}
